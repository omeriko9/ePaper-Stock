# Overlay for the V2 board (ESP32-S3-PICO-1-N8R8: 8 MB flash, 8 MB octal PSRAM).
# The build reads sdkconfig.defaults first, then this file. The pins are the same as V1.
# The flash layout stays at 4 MB, so the partition table and NVS match the V1 build.
# CONFIG_SPIRAM_MODE_QUAD is not set
CONFIG_SPIRAM_MODE_OCT=y
